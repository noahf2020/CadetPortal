# Copy this file to "server/.env" and fill in your TiDB Cloud details.
# (In TiDB Cloud: your cluster -> "Connect" -> pick "General" / "Python",
#  then copy the host, port, user, and password.)
# NEVER commit the real .env file. It is listed in .gitignore.

DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxxxxxx.root
DB_PASSWORD=your-password-here
DB_NAME=cadet_portal
DB_SSL=true

# The tests use this SEPARATE database so they never touch the real data.
TEST_DB_NAME=cadet_portal_test
